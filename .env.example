# Token de acceso de Instagram (obligatorio)
IG_ACCESS_TOKEN=

# ID de la cuenta profesional de Instagram (IG user id). Opcional: si no se define,
# se resuelve con GET /me. Cada tool también acepta ig_user_id para sobreescribirlo.
IG_USER_ID=

# Host de la API:
#  - https://graph.instagram.com  -> "Instagram API with Instagram Login" (default)
#  - https://graph.facebook.com   -> "Instagram API with Facebook Login"
IG_API_HOST=https://graph.instagram.com
IG_API_VERSION=v23.0

# Opcionales, solo para ig_exchange_token (long-lived token) con Instagram Login
IG_APP_ID=
IG_APP_SECRET=
